# Appwrite project (public values; safe to ship in the app)
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_PLATFORM=com.donorlink.app

# Created by `npm run appwrite:provision` (defaults shown)
EXPO_PUBLIC_APPWRITE_DATABASE_ID=donorlink
EXPO_PUBLIC_APPWRITE_FUNCTION_ID=donorlink-api

# NEVER put an Appwrite API key in this file. The provisioning script reads
# APPWRITE_API_KEY from `.env.provision.local`, which is git-ignored.
